PORT=5000
# Copy the Session pooler connection URI from Supabase > Connect.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DATABASE_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Generate a private random value (at least 32 characters); never commit it.
AUTH_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Include the frontend origin(s), comma-separated, when deploying.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
